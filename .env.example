# ZONOE native deployment defaults (BaoTa / systemd, no Docker)
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://ipa.example.com
FRONTEND_ORIGIN=https://ipa.example.com

# Local PostgreSQL
POSTGRES_DB=zonoe
POSTGRES_USER=zonoe
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://zonoe:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/zonoe

# Redis is optional. Leave empty when unused.
REDIS_URL=

# Security
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
IP_HASH_SALT=CHANGE_ME_TO_RANDOM_SALT
SOURCE_CONFIG_KEY=CHANGE_ME_TO_32_BYTE_SECRET_MATERIAL
COOKIE_SECURE=true

# Bootstrap admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com

# Native local storage
LOCAL_STORAGE_DIR=/www/wwwroot/your-domain/data/uploads
MAX_UPLOAD_MB=4096
DOWNLOAD_RATE_LIMIT=120

# GitHub online updater
# stable = GitHub Latest Release. A specific Release tag is also supported.
GITHUB_REPOSITORY=a7987083/ipaxiazaizhan-
GITHUB_RELEASE_CHANNEL=stable
# Optional for private repositories / higher GitHub API limits. Prefer setting
# it in the shell or a root-only secret store instead of committing it here.
# GITHUB_TOKEN=
INSTALL_DIR=/www/wwwroot/your-domain
UPDATE_RUNTIME_DIR=/www/wwwroot/your-domain/data/update-runtime
VERSION_FILE=/www/wwwroot/your-domain/VERSION
DEPLOY_MODE=native
