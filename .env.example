# Core
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://ipa.example.com
FRONTEND_ORIGIN=https://ipa.example.com

# PostgreSQL
POSTGRES_DB=zonoe
POSTGRES_USER=zonoe
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://zonoe:CHANGE_ME_DB_PASSWORD@postgres:5432/zonoe

# Redis (optional but enabled in compose)
REDIS_URL=redis://redis:6379

# Security - replace all in production
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
IP_HASH_SALT=CHANGE_ME_TO_RANDOM_SALT
SOURCE_CONFIG_KEY=CHANGE_ME_TO_32_BYTE_SECRET_MATERIAL
COOKIE_SECURE=true

# Bootstrap admin (used by seed only when no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com

# Local upload storage
LOCAL_STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=4096

# Download rate limit per IP/min
DOWNLOAD_RATE_LIMIT=120

# Release / online updater
GITHUB_REPOSITORY=a7987083/ipaxiazaizhan-
GITHUB_RELEASE_CHANNEL=stable
INSTALL_DIR=/opt/zonoe-ipa-download
UPDATE_RUNTIME_DIR=/runtime/update
VERSION_FILE=/app/VERSION

# Host bindings. BaoTa package overrides these to loopback ports so BaoTa Nginx keeps 80/443.
NGINX_HTTP_BIND=80
NGINX_HTTPS_BIND=443
