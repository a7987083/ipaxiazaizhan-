# ZONOE native deployment defaults (BaoTa / systemd, no Docker)
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://ipa.example.com
FRONTEND_ORIGIN=https://ipa.example.com

# 2026091208+: App data is read directly from one or more existing MySQL
# software-source databases. Add/edit those sources in the Admin UI.
# ZONOE does not create a second application database and does not copy IPA files.
CONTROL_DIR=/www/wwwroot/your-domain/data/control
MYSQL_BIN=/www/server/mysql/bin/mysql

# Security
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
IP_HASH_SALT=CHANGE_ME_TO_RANDOM_SALT
SOURCE_CONFIG_KEY=CHANGE_ME_TO_32_BYTE_SECRET_MATERIAL
COOKIE_SECURE=true

# Bootstrap admin. ADMIN_PASSWORD is used only if data/control/admin.json does
# not exist yet. After changing password in the Admin UI, the stored bcrypt hash
# is authoritative and upgrades do not overwrite it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com

DOWNLOAD_RATE_LIMIT=120

# GitHub online updater
GITHUB_REPOSITORY=a7987083/ipaxiazaizhan-
GITHUB_RELEASE_CHANNEL=stable
# GITHUB_TOKEN=
INSTALL_DIR=/www/wwwroot/your-domain
UPDATE_RUNTIME_DIR=/www/wwwroot/your-domain/data/update-runtime
VERSION_FILE=/www/wwwroot/your-domain/VERSION
DEPLOY_MODE=native
